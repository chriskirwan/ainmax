from collections.abc import Sequence
from typing import Any, Self

import numpy as np
from jax import Array, Device
from jax.lax import PrecisionLike
from jax.sharding import Sharding
from jax.typing import DTypeLike
from jaxtyping import ScalarLike

from lynqx._src.axis import Axis, AxisLike, AxisSelection, AxisSelector, AxisShape
from lynqx._src.named import DotContraction, NamedIndexUpdateHelper, StaticScalar
from lynqx._src.partition import ShardingLike

class NamedArray:
    array: Array
    axes: tuple[Axis, ...]

    @property
    def dtype(self) -> np.dtype: ...
    @property
    def itemsize(self) -> int: ...
    @property
    def nbytes(self) -> int: ...
    @property
    def ndim(self) -> int: ...
    @property
    def size(self) -> int: ...
    @property
    def shape(self) -> tuple[int, ...]: ...

    # Array dunders
    def __getitem__(self, key: Any) -> Self: ...
    def __setitem__(self, key, value) -> None: ...

    ## Comparisons
    def __lt__(self, other: NamedArrayLike) -> Self: ...
    def __le__(self, other: NamedArrayLike) -> Self: ...
    def __eq__(self, other: object, /) -> Any: ...
    def __ne__(self, other: object, /) -> Any: ...
    def __gt__(self, other: NamedArrayLike) -> Self: ...
    def __ge__(self, other: NamedArrayLike) -> Self: ...

    ## Unary Arithmetic
    def __neg__(self) -> Self: ...
    def __pos__(self) -> Self: ...
    def __abs__(self) -> Self: ...
    def __invert__(self) -> Self: ...

    ## Binary Arithmetic
    def __add__(self, other: NamedArrayLike) -> Self: ...
    def __sub__(self, other: NamedArrayLike) -> Self: ...
    def __mul__(self, other: NamedArrayLike) -> Self: ...
    def __truediv__(self, other: NamedArrayLike) -> Self: ...
    def __floordiv__(self, other: NamedArrayLike) -> Self: ...
    def __mod__(self, other: NamedArrayLike) -> Self: ...
    def __divmod__(self, other: NamedArrayLike) -> tuple[Self, Self]: ...
    def __pow__(self, other: NamedArrayLike) -> Self: ...
    def __lshift__(self, other: NamedArrayLike) -> Self: ...
    def __rshift__(self, other: NamedArrayLike) -> Self: ...
    def __and__(self, other: NamedArrayLike) -> Self: ...
    def __xor__(self, other: NamedArrayLike) -> Self: ...
    def __or__(self, other: NamedArrayLike) -> Self: ...
    def __radd__(self, other: NamedArrayLike) -> Self: ...
    def __rsub__(self, other: NamedArrayLike) -> Self: ...
    def __rmul__(self, other: NamedArrayLike) -> Self: ...
    def __rtruediv__(self, other: NamedArrayLike) -> Self: ...
    def __rfloordiv__(self, other: NamedArrayLike) -> Self: ...
    def __rmod__(self, other: NamedArrayLike) -> Self: ...
    def __rdivmod__(self, other: NamedArrayLike) -> tuple[Self, Self]: ...
    def __rpow__(self, other: NamedArrayLike) -> Self: ...
    def __rlshift__(self, other: NamedArrayLike) -> Self: ...
    def __rrshift__(self, other: NamedArrayLike) -> Self: ...
    def __rand__(self, other: NamedArrayLike) -> Self: ...
    def __rxor__(self, other: NamedArrayLike) -> Self: ...
    def __ror__(self, other: NamedArrayLike) -> Self: ...

    # Casting
    def __bool__(self) -> bool: ...
    def __complex__(self) -> complex: ...
    def __int__(self) -> int: ...
    def __float__(self) -> float: ...
    def __index__(self) -> int: ...

    # np.ndarray methods
    def all(
        self, axis: AxisSelection | None = None, keepdims: bool = False, *, where: NamedArrayLike | None = None
    ) -> Self: ...
    def any(
        self, axis: AxisSelection | None = None, keepdims: bool = False, *, where: NamedArrayLike | None = None
    ) -> Self: ...
    def argmax(self, axis: AxisSelection | None = None, keepdims: bool = False) -> Self: ...
    def argmin(self, axis: AxisSelection | None = None, keepdims: bool = False) -> Self: ...
    def argpartition(self, kth: int, axis: AxisSelection) -> Self: ...
    def argsort(
        self,
        axis: AxisSelection | None = None,
        *,
        kind: str | None = None,
        order: str | None = None,
        dtype: DTypeLike | None = None,
    ) -> Self: ...
    def astype(
        self, dtype: DTypeLike | None = None, copy: bool = False, device: Device | ShardingLike | None = None
    ) -> Self: ...
    def byteswap(self) -> Self: ...
    def choose(self, choices: Sequence[NamedArrayLike], *, mode: str = "raise") -> Self: ...
    def clip(self, *, min: NamedArrayLike, max: NamedArrayLike) -> Self: ...
    def compress(self, a: NamedArrayLike, axis, *, size, fill_value) -> Self: ...
    def conj(self) -> Self: ...
    def conjugate(self) -> Self: ...
    def copy(self) -> Self: ...
    def cumprod(self, axis: AxisLike, dtype: DTypeLike | None = None) -> Self: ...
    def cumsum(self, axis: AxisLike, dtype: DTypeLike | None = None) -> Self: ...
    def diagonal(
        self, axis1: AxisSelector = 0, axis2: AxisSelector = 1, diagonal: AxisLike | None = None, offset: int = 0
    ) -> Self: ...
    def dot(
        self,
        b: NamedArrayLike,
        spec: DotContraction,
        *,
        precision: PrecisionLike,
        preferred_element_type: DTypeLike | None = None,
        out_sharding: ShardingLike | None = None,
    ) -> Self: ...
    def flatten(self, name: AxisLike | None = None) -> Self: ...
    @property
    def imag(self) -> Self: ...
    def item(self) -> bool | int | float | complex: ...
    def max(
        self,
        axis: AxisSelection | None = None,
        keepdims: bool = False,
        initial: ScalarLike | None = None,
        where: NamedArrayLike | None = None,
    ) -> Self: ...
    def mean(
        self,
        axis: AxisSelection | None = None,
        dtype: DTypeLike | None = None,
        keepdims: bool = False,
        where: NamedArrayLike | None = None,
    ) -> Self: ...
    def min(
        self,
        axis: AxisSelection | None = None,
        keepdims: bool = False,
        initial: ScalarLike | None = None,
        where: NamedArrayLike | None = None,
    ) -> Self: ...
    def nonzero(self, *, size: int | None = None, fill_value: NamedArrayLike | None = None) -> Self: ...
    def prod(
        self,
        axis: AxisSelection | None = None,
        dtype: DTypeLike | None = None,
        keepdims: bool = False,
        initial: ScalarLike | None = None,
        where: NamedArrayLike | None = None,
        promote_integers: bool = True,
    ) -> Self: ...
    def ptp(self, axis: AxisSelection | None = None, keepdims: bool = False) -> Self: ...
    def ravel(self, name: AxisLike) -> Self: ...
    def repeat(
        self,
        repeats: NamedArrayLike,
        axis: AxisSelector | None = None,
        *,
        total_repeat_length: int | None = None,
        out_sharding: ShardingLike | None = None,
    ) -> Self: ...
    @property
    def real(self) -> Self: ...
    def reshape(self, shape: AxisShape, *, out_sharding: ShardingLike | None = None) -> Self: ...
    def round(self, decimals: int = 0) -> Self: ...
    def searchsorted(
        self,
        v: NamedArrayLike,
        side: str = "left",
        sorter: NamedArrayLike | None = None,
        *,
        method: str = "scan",
    ) -> Self: ...
    def sort(
        self,
        axis: AxisSelector | None = -1,
        *,
        stable: bool = True,
        descending: bool = False,
        kind: str | None = None,
        order: str | None = None,
    ) -> Self: ...
    def squeeze(self, axis: AxisSelection | None = None) -> Self: ...
    def std(
        self,
        axis: AxisSelection | None = None,
        dtype: DTypeLike | None = None,
        ddof: int = 0,
        keepdims: bool = False,
        *,
        where: NamedArrayLike | None = None,
        correction: int | float | None = None,
    ) -> Self: ...
    def sum(
        self,
        axis: AxisSelection | None = None,
        dtype: DTypeLike | None = None,
        keepdims: bool = False,
        initial: ScalarLike | None = None,
        where: NamedArrayLike | None = None,
        promote_integers: bool = False,
    ) -> Self: ...
    def swapaxes(self, axis1: AxisSelector, axis2: AxisSelector) -> Self: ...
    def take(
        self,
        axis: AxisSelector,
        index: NamedArrayLike,
        *,
        mode: str | None = None,
        fill_value: StaticScalar | None = None,
        unique_indices: bool = False,
        indices_are_sorted: bool = False,
    ) -> Self: ...
    def trace(
        self, offset: int = 0, axis1: AxisSelector = 0, axis2: AxisSelector = 1, dtype: DTypeLike | None = None
    ) -> Self: ...
    def transpose(self, permutation: AxisSelection | None = None) -> Self: ...
    def var(
        self,
        axis: AxisSelection | None = None,
        dtype: DTypeLike | None = None,
        ddof: int = 0,
        keepdims: bool = False,
        *,
        where: NamedArrayLike | None = None,
        correction: int | float | None = None,
    ) -> Self: ...
    def view(self, dtype: DTypeLike | None = None) -> Self: ...

    # JAX Extensions
    @property
    def at(self) -> NamedIndexUpdateHelper: ...
    @property
    def sharding(self) -> Sharding: ...
    def to_device(self, device: Device | ShardingLike) -> Self: ...
    def __array__(self, dtype: np.dtype | None = ..., context: None = ..., copy: bool | None = ...) -> np.ndarray: ...

    # Lynqx Extensions
    def rename(self, axis: AxisSelector, name: str | None = None) -> Self: ...
    # def to_numpy(self) -> np.ndarray: ...

NamedArrayLike = NamedArray | ScalarLike
